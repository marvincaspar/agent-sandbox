#!/usr/bin/env bash
set -euo pipefail

# Wrapper script to run the pi coding agent inside a hardened Docker container.
#
# Features:
#   - Multi-language targets: base, go, php8.5 (--lang)
#   - Optional image rebuild before running (--build)
#   - Optional tinyproxy sidecar for restricted outbound network access (--proxy)
#     with a configurable allowed-domains allowlist (--allowed-domains)
#   - Isolated internal Docker network when proxy is active
#   - Hardened container: capabilities dropped, no-new-privileges, private IPC
#   - Mounts current working directory, ~/.pi/agent, dotai, skills, and
#     ~/.config/acli read-write; entrypoint and xdg-open shim mounted read-only
#   - Mounts explicit absolute @file attachments and extension files read-only
#   - Mounts the factory's single existing proposal output file read-write
#   - Forwards common API keys and pi env-vars from the host environment
#   - Passes a system prompt informing pi it is running as a non-root Docker user
#   - Any unrecognised arguments are forwarded verbatim to pi (use '--' to avoid
#     flag conflicts)

readonly PI_IMAGE='pi-yolo'
readonly PI_PROXY_IMAGE='pi-proxy'
readonly LANGS=(base)

SCRIPT_HOME="$(dirname "$(realpath "$0")")"
readonly SCRIPT_HOME

function check_docker() {
    if ! command -v docker &>/dev/null; then
        echo "Error: docker is not installed or not in PATH" >&2
        exit 1
    fi
    if ! docker info &>/dev/null; then
        echo "Error: Docker daemon is not running" >&2
        exit 1
    fi
}

function script_usage() {
    cat << EOF
Usage:
    pi [OPTIONS] [PI_ARGS...]
    pi [OPTIONS] -- [PI_ARGS...]

Options:
    -h|--help                   Displays this help
    -b|--build                  Rebuild the Docker image before running
    -l|--lang <LANG>            Specify language target (default: base). Valid options: ${LANGS[*]}
    -p|--proxy                  Start the proxy sidecar (restricted network access)
    --allowed-domains <file>    Path to allowed-domains file
                                (default: ~/.agents/proxy_allowed_domains.txt)

Any unrecognised options and arguments are forwarded to the pi agent.
Use '--' to pass flags to pi that would otherwise conflict with this script.
EOF
}

function build_proxy_image() {
    echo "Building Docker image: ${PI_PROXY_IMAGE} ..." >&2
    docker buildx build \
        --file "${SCRIPT_HOME}/../proxy/Dockerfile" \
        --tag "${PI_PROXY_IMAGE}:latest" \
        "${SCRIPT_HOME}/../proxy" >&2
}

function build_image() {
    echo "Building Docker image: ${PI_IMAGE} ..." >&2
    for target in "${LANGS[@]}"; do
        echo "Building target stage: ${target} ..." >&2
        docker buildx build \
            --file "${SCRIPT_HOME}/Dockerfile" \
            --target "${target}" \
            --tag "${PI_IMAGE}:${target}" \
            "${SCRIPT_HOME}" >&2
    done

    build_proxy_image
}


function start_proxy() {
    local proxy_allowed_domains_file="$1"
    local network_name="$2"
    local proxy_container="$3"

    echo "Starting proxy sidecar container '${proxy_container}' on network '${network_name}'..." >&2
    # Isolated internal network: pi container has no direct internet access.
    docker network create --internal "${network_name}" >/dev/null

    echo "Running proxy container '${proxy_container}'..." >&2
    # Proxy runs on the default bridge (internet access) and the internal network.
    docker run -d \
        --rm \
        --name "${proxy_container}" \
        --volume "${proxy_allowed_domains_file}:/etc/tinyproxy/allowed_domains.txt:ro" \
        "${PI_PROXY_IMAGE}:latest" >/dev/null

    echo "Connecting proxy container '${proxy_container}' to network '${network_name}'..." >&2
    # Connect proxy to the internal network so the pi container can reach it.
    docker network connect "${network_name}" "${proxy_container}" >/dev/null

    # Wait for tinyproxy to be ready (HEALTHCHECK in Dockerfile drives this).
    local attempts=0 state
    until [[ "$(docker inspect --format '{{.State.Health.Status}}' "${proxy_container}" 2>/dev/null)" == "healthy" ]]; do
        attempts=$((attempts + 1))
        if [[ $attempts -ge 30 ]]; then
            echo "Error: proxy container failed to become healthy" >&2
            docker logs "${proxy_container}" >&2 2>/dev/null || true
            return 1
        fi
        state=$(docker inspect --format '{{.State.Status}}' "${proxy_container}" 2>/dev/null || echo "gone")
        if [[ "$state" != "running" ]]; then
            echo "Error: proxy container exited unexpectedly" >&2
            echo "--- proxy logs ---" >&2
            docker logs "${proxy_container}" >&2 2>/dev/null || true
            return 1
        fi
        sleep 1
    done

    # Return the proxy's IP on the internal network.
    docker inspect "${proxy_container}" \
        --format "{{(index .NetworkSettings.Networks \"${network_name}\").IPAddress}}"
}

function stop_proxy() {
    local network_name="$1"
    local proxy_container="$2"
    docker stop "${proxy_container}" >/dev/null 2>&1 || true
    docker network rm "${network_name}" >/dev/null 2>&1 || true
}

function parse_params() {
    local param
    while [[ $# -gt 0 ]]; do
        param="$1"
        shift
        case $param in
            -h | --help)
                script_usage
                exit 0
                ;;
            -b | --build)
                build=true
                ;;
            -l | --lang)
                lang="$1"
                shift
                ;;
            -p | --proxy)
                proxy_flag=true
                ;;
            --allowed-domains)
                proxy_allowed_domains_file="$1"
                shift
                ;;
            --factory-read-only)
                factory_read_only=true
                ;;
            --factory-repository)
                [[ $# -gt 0 ]] || { echo "Error: missing repository path" >&2; exit 1; }
                factory_repositories+=("$1")
                shift
                ;;
            --)
                # Everything after -- is forwarded verbatim to pi
                pi_passthrough+=("$@")
                return
                ;;
            *)
                pi_passthrough+=("${param}")
                ;;
        esac
    done
}


function configure_git_signing() {
    if [[ "${factory_read_only}" == true || "$(git config --type=bool --get commit.gpgsign || true)" != true ]]; then
        return
    fi
    if [[ "$(git config --get gpg.format || true)" != ssh ]]; then
        echo "Error: the sandbox supports SSH signing only; set gpg.format=ssh on the host" >&2
        return 1
    fi

    local signing_key key_type signing_name signing_email agent_socket agent_gid
    signing_key="$(git config --path --get user.signingkey || true)"
    if [[ "${signing_key}" != /* || ! -f "${signing_key}" || "${signing_key}" == *,* ]]; then
        echo "Error: user.signingkey must name an existing public signing key without mount delimiters" >&2
        return 1
    fi
    read -r key_type _ < "${signing_key}" || true
    case "${key_type}" in
        ssh-*|ecdsa-sha2-*|sk-*) ;;
        *) echo "Error: user.signingkey must be a public signing key; private keys are never mounted" >&2; return 1 ;;
    esac
    signing_name="$(git config --get user.name || true)"
    signing_email="$(git config --get user.email || true)"
    if [[ -z "${signing_name}" || -z "${signing_email}" ]]; then
        echo "Error: SSH signing requires user.name and user.email on the host" >&2
        return 1
    fi
    if [[ -z "${SSH_AUTH_SOCK:-}" || ! -S "${SSH_AUTH_SOCK}" ]]; then
        echo "Error: SSH signing requires SSH_AUTH_SOCK to point to a running host SSH agent" >&2
        return 1
    fi
    case "$(uname -s)" in
        # Docker Desktop's bridge socket is root:root, mode 0660 inside the VM.
        Darwin) agent_socket="/run/host-services/ssh-auth.sock"; agent_gid=0 ;;
        Linux) agent_socket="${SSH_AUTH_SOCK}"; agent_gid="$(stat -Lc '%g' "${agent_socket}")" ;;
        *) echo "Error: SSH agent forwarding is supported on macOS Docker Desktop and Linux" >&2; return 1 ;;
    esac
    if [[ "${agent_socket}" == *,* ]]; then
        echo "Error: SSH_AUTH_SOCK must not contain mount delimiters" >&2
        return 1
    fi
    git_signing_flags+=(
        --mount "type=bind,source=${agent_socket},target=/run/ssh-agent"
        --group-add "${agent_gid}"
        --env SSH_AUTH_SOCK=/run/ssh-agent
        --mount "type=bind,source=${signing_key},target=/run/git-signing-key.pub,readonly"
        --env GIT_CONFIG_COUNT=5
        --env GIT_CONFIG_KEY_0=user.name
        --env "GIT_CONFIG_VALUE_0=${signing_name}"
        --env GIT_CONFIG_KEY_1=user.email
        --env "GIT_CONFIG_VALUE_1=${signing_email}"
        --env GIT_CONFIG_KEY_2=gpg.format
        --env GIT_CONFIG_VALUE_2=ssh
        --env GIT_CONFIG_KEY_3=user.signingkey
        --env GIT_CONFIG_VALUE_3=/run/git-signing-key.pub
        --env GIT_CONFIG_KEY_4=commit.gpgsign
        --env GIT_CONFIG_VALUE_4=true
    )
}

readonly URL_PIPE="/tmp/fake-browser.$$.log"

function clean_pipe() {
  echo "Removing named pipe ${URL_PIPE} ..."
  rm -rf "${URL_PIPE}"
}

function main() {
    check_docker

    build=false
    lang="base"
    proxy_flag=false
    proxy_allowed_domains_file=""
    pi_passthrough=()
    factory_read_only=false
    factory_repositories=()

    parse_params "$@"

    local git_signing_flags=()
    configure_git_signing

    if [[ "${build}" == true ]]; then
        build_image
    else
        if ! docker image inspect "${PI_IMAGE}:${lang}" &>/dev/null; then
            echo "Image '${PI_IMAGE}:${lang}' not found. Building it first..." >&2
            build_image
        fi
        if [[ "${proxy_flag}" == true ]] && ! docker image inspect "${PI_PROXY_IMAGE}:latest" &>/dev/null; then
            echo "Image '${PI_PROXY_IMAGE}' not found. Building it first..." >&2
            build_proxy_image
        fi
    fi

    if [[ ! " ${LANGS[*]} " =~ " ${lang} " ]]; then
        echo "Error: unknown lang '${lang}'. Valid: ${LANGS[*]}" >&2
        exit 1
    fi

    echo "Running pi in Docker container '${PI_IMAGE}' with language target '${lang}'..." >&2

    # Optionally start proxy sidecar and isolated network.
    local network_name="pi-net-$$"
    local proxy_container="pi-proxy-$$"

    if [[ "${proxy_flag}" == true ]]; then
        if [[ -z "${proxy_allowed_domains_file}" ]]; then
            proxy_allowed_domains_file="${HOME}/.agents/proxy_allowed_domains.txt"
        fi
        if [[ ! -f "${proxy_allowed_domains_file}" ]]; then
            echo "Error: allowed-domains file not found: ${proxy_allowed_domains_file}" >&2
            exit 1
        fi
        trap "stop_proxy '${network_name}' '${proxy_container}'" clean_pipe EXIT
        echo "Starting proxy sidecar (allowed-domains: ${proxy_allowed_domains_file})..." >&2
        local proxy_ip
        proxy_ip=$(start_proxy "${proxy_allowed_domains_file}" "${network_name}" "${proxy_container}")
        echo "Proxy ready at ${proxy_ip}:8888" >&2
    else
        echo "Proxy disabled (--proxy): unrestricted network access." >&2
        trap clean_pipe EXIT
    fi

    clean_pipe

    touch "${URL_PIPE}"

    # tail -n 0: only follow lines written after this process starts (skip stale entries).
    # Pipe gives FIFO semantics on the host side; the file is only used to cross
    # the Docker VirtioFS boundary (VirtioFS does not support mounted FIFOs on macOS).
    # WSL reports Linux via uname, so check it before the generic Linux case.
    # Prefer wslview (wslu package); fall back to explorer.exe which is always available in WSL.
    if grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
        if command -v wslview &>/dev/null; then
            _open_cmd='wslview'
        else
            _open_cmd='explorer.exe'
        fi
    else
        case "$(uname -s)" in
            Darwin) _open_cmd='open' ;;
            Linux)  _open_cmd='xdg-open' ;;
            *)      echo "Warning: unsupported OS, defaulting to xdg-open" >&2; _open_cmd='xdg-open' ;;
        esac
    fi

    tail -n 0 -f "${URL_PIPE}" | while read -r URL; do
        [[ -z "${URL}" ]] && continue
        "${_open_cmd}" "${URL}"
    done &

    local current_user
    current_user="$(id -u):$(id -g)"

    local container_workdir="$(pwd)"
    local workspace_flags=('--mount' "type=bind,source=$(pwd),target=$(pwd)")
    if [[ "${factory_read_only}" == true ]]; then
        # Planning needs an empty working directory, not a bind of the new host run directory.
        container_workdir="/factory-workspace"
        workspace_flags=('--tmpfs' "${container_workdir}:ro,mode=0555")
    fi
    local docker_flags=(
        '--rm'
        '--user' "${current_user}"
        '--interactive'
        '--tty'
        # Drop all Linux capabilities (NET_RAW, SYS_PTRACE, …) so a compromised
        # process cannot manipulate the network stack, trace other processes, or
        # perform privileged kernel operations.
        '--cap-drop=ALL'
        # Prevent any exec inside the container from gaining capabilities via
        # setuid/setgid binaries or file capability bits (e.g. sudo, ping).
        '--security-opt=no-new-privileges'
        # Disable access to the host's IPC namespace (shared memory, semaphores,
        # message queues) so the container cannot communicate with or interfere
        # with other containers or host processes via IPC primitives.
        '--ipc=none'
        "${workspace_flags[@]}"
        "${git_signing_flags[@]+"${git_signing_flags[@]}"}"
        '--volume' "${HOME}/.pi/agent:/home/piuser/.pi/agent"
        '--volume' "${HOME}/.agents:/home/piuser/.agents"
        '--volume' "${HOME}/.config/acli:/home/piuser/.config/acli"
        '--volume' "${HOME}/.context-mode:/home/piuser/.pi/context-mode"
        '--volume' "${SCRIPT_HOME}/entrypoint.sh:/usr/local/bin/entrypoint.sh:ro"
        '--volume' "${URL_PIPE}:/tmp/fake-browser.log"
        '--workdir' "${container_workdir}"
        '--env' "PI_TELEMETRY=${PI_TELEMETRY:-false}"
        '--env' "TERM=${TERM:-xterm-256color}"
        '--env' "COLORTERM=${COLORTERM:-truecolor}"
    )

    local repository
    for repository in "${factory_repositories[@]+"${factory_repositories[@]}"}"; do
        if [[ "${factory_read_only}" != true || "${repository}" != /* || ! -d "${repository}" || -L "${repository}" || "${repository}" == *[:,]* ]]; then
            echo "Error: factory repositories require read-only mode and absolute directory paths without mount delimiters" >&2
            exit 1
        fi
        docker_flags+=('--volume' "${repository}:${repository}:ro")
    done

    # Expose only explicit files, never their parent directory. The factory export
    # tool gets one writable transport file, not access to authoritative plan storage.
    local arg attachment mounted_attachment already_mounted previous_arg="" mount_mode
    local attachment_mounts=()
    for arg in "${pi_passthrough[@]+"${pi_passthrough[@]}"}"; do
        attachment=""
        mount_mode=ro
        case "${previous_arg}" in
            --extension|-e) if [[ "${arg}" == /* ]]; then attachment="${arg}"; fi ;;
            --factory-plan-output|--factory-handoff-output) attachment="${arg}"; mount_mode=rw ;;
            --factory-planning-context) attachment="${arg}" ;;
        esac
        previous_arg="${arg}"
        if [[ -z "${attachment}" && "${arg}" == @/* ]]; then
            attachment="${arg#@}"
        fi
        [[ -n "${attachment}" ]] || continue
        if [[ "${mount_mode}" == rw && ( "${attachment}" != /* || ! -f "${attachment}" || -L "${attachment}" ) ]]; then
            echo "Error: factory output requires an existing absolute regular file, not a symlink" >&2
            exit 1
        fi
        [[ -f "${attachment}" ]] || continue
        # Only normal sessions bind the host working directory.
        [[ "${factory_read_only}" != true && "${attachment}" == "$(pwd)/"* ]] && continue
        already_mounted=false
        for mounted_attachment in "${attachment_mounts[@]+"${attachment_mounts[@]}"}"; do
            if [[ "${mounted_attachment%:*}" == "${attachment}" ]]; then
                if [[ "${mounted_attachment##*:}" != "${mount_mode}" ]]; then
                    echo "Error: conflicting read/write mounts for an explicit input file" >&2
                    exit 1
                fi
                already_mounted=true
            fi
        done
        [[ "${already_mounted}" == true ]] && continue
        printf 'Mounting explicit file (%s): %s\n' "${mount_mode}" "${attachment}" >&2
        docker_flags+=('--volume' "${attachment}:${attachment}:${mount_mode}")
        attachment_mounts+=("${attachment}:${mount_mode}")
    done

    if [[ "$(pwd)" != "${HOME}/dotai" ]]; then
        docker_flags+=(
            '--volume' "${HOME}/dotai:${HOME}/dotai" # Used because .pi and .agent config is symlinked from here to user's home.
        )
    fi

    if [[ "${proxy_flag}" == true ]]; then
        docker_flags+=(
            '--network' "${network_name}"
            '--env' "HTTP_PROXY=http://${proxy_ip}:8888"
            '--env' "HTTPS_PROXY=http://${proxy_ip}:8888"
            '--env' "http_proxy=http://${proxy_ip}:8888"
            '--env' "https_proxy=http://${proxy_ip}:8888"
            '--env' "NO_PROXY=localhost,127.0.0.1"
            '--env' "no_proxy=localhost,127.0.0.1"
        )
    fi

    # Forward pi-related env vars and API keys if set on the host.
    # Auth file (~/.pi/agent/auth.json) takes priority over these if present.
    local pi_env_vars=(
        PI_TIMING
        PI_STARTUP_BENCHMARK
        PI_SKIP_VERSION_CHECK
        PI_CACHE_RETENTION
        PI_PACKAGE_DIR
        VISUAL
        EDITOR
        ANTHROPIC_API_KEY
        OPENAI_API_KEY
        GEMINI_API_KEY
        OPENCODE_API_KEY
    )
    local var
    for var in "${pi_env_vars[@]}"; do
        [[ -n "${!var:-}" ]] && docker_flags+=('--env' "${var}=${!var}")
    done

    # Keep the OAuth encryption key out of docker's command-line arguments.
    if [[ -f "${HOME}/.config/pi-mcp-oauth.key" ]]; then
        PI_MCP_ADAPTER_OAUTH_FILE_KEY="$(tr -d '\n' < "${HOME}/.config/pi-mcp-oauth.key")"
        export PI_MCP_ADAPTER_OAUTH_FILE_KEY
    fi
    [[ -n "${PI_MCP_ADAPTER_OAUTH_FILE_KEY:-}" ]] && docker_flags+=('--env' 'PI_MCP_ADAPTER_OAUTH_FILE_KEY')

    local pi_args=(
        '--append-system-prompt'
        'You are running inside a Docker container as a non-root user. No Docker socket, sudo, or system package installation (apk requires root) is available.'
    )

    docker run "${docker_flags[@]}" "${PI_IMAGE}:${lang}"  "${pi_args[@]}" \
        "${pi_passthrough[@]+"${pi_passthrough[@]}"}"
}

main "$@"
